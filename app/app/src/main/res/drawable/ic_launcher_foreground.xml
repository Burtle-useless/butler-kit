<?xml version="1.0" encoding="utf-8"?>
<!--
  啟動圖示：助理的螢幕臉。
  桌寵本體是 Compose Canvas 手繪，launcher 吃的是 VectorDrawable 的 pathData，
  沒辦法直接沿用程式碼，所以這裡把同一張臉的幾何重畫一次。

  尺寸紀律（上一版就是栽在這裡）：畫布 108x108，但只有**中央直徑 66 的圓**
  是各家遮罩都保證看得到的範圍。上一版機體寬 74，超出後左右被裁掉，
  白框變成一條橫貫的白帶、上下露出背景圓，非常難看。
  現在機體收到 52x38（角落到中心 32.2 < 33），四角都在安全圓內。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 機體外框 -->
    <path
        android:pathData="M36,35 h36 a8,8 0 0 1 8,8 v22 a8,8 0 0 1 -8,8 h-36 a8,8 0 0 1 -8,-8 v-22 a8,8 0 0 1 8,-8 z"
        android:fillColor="#EDF0F5" />
    <!-- 螢幕 -->
    <path
        android:pathData="M39,40 h30 a5,5 0 0 1 5,5 v18 a5,5 0 0 1 -5,5 h-30 a5,5 0 0 1 -5,-5 v-18 a5,5 0 0 1 5,-5 z"
        android:fillColor="#0E1420" />
    <!-- 左眼 -->
    <path
        android:pathData="M43,49 h6 a2.5,2.5 0 0 1 2.5,2.5 v5 a2.5,2.5 0 0 1 -2.5,2.5 h-6 a2.5,2.5 0 0 1 -2.5,-2.5 v-5 a2.5,2.5 0 0 1 2.5,-2.5 z"
        android:fillColor="#5CCFE6" />
    <!-- 右眼 -->
    <path
        android:pathData="M59,49 h6 a2.5,2.5 0 0 1 2.5,2.5 v5 a2.5,2.5 0 0 1 -2.5,2.5 h-6 a2.5,2.5 0 0 1 -2.5,-2.5 v-5 a2.5,2.5 0 0 1 2.5,-2.5 z"
        android:fillColor="#5CCFE6" />
</vector>
