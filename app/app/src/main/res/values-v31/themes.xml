<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 的啟動畫面：底色同 Palette.Bg，圖示跟 launcher 同一顆。
         不明寫的話底色取 colorBackground，圖示外會多一圈系統的預設處理 -->
    <style name="Theme.Butler" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
